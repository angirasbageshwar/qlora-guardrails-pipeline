# ── Copy to .env ──────────────────────────────────────────────────────────────
# Hugging Face token (needed for gated models like Llama 3)
HF_TOKEN=hf_...

# Weights & Biases experiment tracking
WANDB_API_KEY=...
WANDB_PROJECT=qlora-domain-llm

# Serving
VLLM_BASE_URL=http://localhost:8000
SERVED_MODEL_NAME=domain-llm
GATEWAY_PORT=9000

# Guardrails
BLOCK_ON_PII=false          # false = mask PII and continue; true = reject request
USE_NEMO=false              # true = also run NeMo Guardrails self-check rails
